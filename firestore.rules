rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed(){ return request.auth != null; }
    function tid(){ return request.auth.token.telegram_id; }

    match /publicConfig/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /vipPlans/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /users/{id} {
      allow read: if signed() && id == string(tid());
      allow write: if false;
    }
    match /vipPurchases/{id} {
      allow read: if signed() && resource.data.userTelegramId == tid();
      allow write: if false;
    }
    match /deposits/{id} {
      allow read: if signed() && resource.data.userTelegramId == tid();
      allow write: if false;
    }
    match /withdrawals/{id} {
      allow read: if signed() && resource.data.userTelegramId == tid();
      allow write: if false;
    }
    match /transactions/{id} {
      allow read: if signed() && resource.data.userTelegramId == tid();
      allow write: if false;
    }
    match /referrals/{id} {
      allow read: if signed() && (resource.data.inviterTelegramId == tid() || resource.data.invitedTelegramId == tid());
      allow write: if false;
    }
    match /system/{id} {
      allow read, write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
