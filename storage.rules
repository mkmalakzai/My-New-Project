rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /deposit-proofs/{telegramId}/{fileName} {
      allow read: if request.auth != null && (request.auth.token.admin == true || string(request.auth.token.telegram_id) == telegramId);
      allow write: if request.auth != null && string(request.auth.token.telegram_id) == telegramId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
